\cf2 Python fuzzy-matching tools return a 
\f7\b similarity score\

\f3\b0 ibraries commonly used for this include 
\f7\b RapidFuzz
\f3\b0  and the older 
\f7\b FuzzyWuzzy/TheFuzz-style APIs
\f3\b0 .
\fs36 \cf2 \
\pard\tx860\tx1420\tx1980\tx2540\tx3100\tx3660\tx4220\tx4780\tx5340\tx5900\tx6460\tx7020\li300\sl324\slmult1\partightenfactor0
\cf2 \
# =========================================\
# Fuzzy Matching in Python \'96 Self-Healing\
# =========================================\
\
# Concept:\
# Fuzzy matching compares strings that are NOT exactly the same,\
# but are similar, and gives a similarity score (0\'96100).\
\
# Example:\
# "login_btn" vs "login_button" \uc0\u8594  ~85\'9695% similar\
\
# -----------------------------------------\
# Why this is important in QA\
# -----------------------------------------\
# Problem:\
# Locator changes break automation tests\
\
# Old locator:\
# id = "login_btn"\
\
# New locator:\
# id = "login_button"\
\
# Normal Selenium:\
# "login_btn" != "login_button" \uc0\u8594  Test fails 
\f2 \uc0\u10060 
\f3 \
\
# Fuzzy Matching:\
# Compare similarity \uc0\u8594  choose closest match \u8594  Test continues 
\f2 \uc0\u9989 
\f3 \
\
\
# -----------------------------------------\
# Install library (Run once)\
# -----------------------------------------\
# pip install rapidfuzz\
\
\
# -----------------------------------------\
# Basic Fuzzy Matching Example\
# -----------------------------------------\
from rapidfuzz import fuzz, process\
\
old_locator = "login_btn"\
\
available_locators = [\
    "login_button",\
    "signup_btn",\
    "home_link",\
    "login_link",\
    "logout_button"\
]\
\
print("Comparing locators using fuzzy matching:\\n")\
\
for locator in available_locators:\
    score = fuzz.ratio(old_locator, locator)\
    print(f"\{locator\} -> similarity score = \{score\}")\
\
# Find best match automatically\
best_match = process.extractOne(old_locator, available_locators, scorer=fuzz.ratio)\
\
print("\\nBest Match:", best_match[0])\
print("Best Score:", best_match[1])\
\
\
# -----------------------------------------\
# Expected Output Example\
# -----------------------------------------\
# login_button -> similarity score = 85.7\
# signup_btn -> similarity score = 63.1\
# home_link -> similarity score = 22.2\
# login_link -> similarity score = 70.0\
# logout_button -> similarity score = 45.0\
#\
# Best Match: login_button\
# Best Score: 85.7\
\
\
# -----------------------------------------\
# AI-Style Self-Healing (Advanced)\
# -----------------------------------------\
# Instead of comparing only strings, we compare full element properties\
\
old_element = \{\
    "id": "login_btn",\
    "text": "Login",\
    "tag": "button",\
    "type": "submit"\
\}\
\
candidate_elements = [\
    \{\
        "id": "login_button",\
        "text": "Login",\
        "tag": "button",\
        "type": "submit"\
    \},\
    \{\
        "id": "signin_btn",\
        "text": "Sign In",\
        "tag": "button",\
        "type": "submit"\
    \},\
    \{\
        "id": "home_link",\
        "text": "Home",\
        "tag": "a",\
        "type": ""\
    \}\
]\
\
\
def calculate_confidence(old_element, candidate):\
    # Compare ID similarity (40%)\
    id_score = fuzz.ratio(old_element["id"], candidate["id"])\
\
    # Compare visible text (30%)\
    text_score = fuzz.ratio(old_element["text"], candidate["text"])\
\
    # Compare tag (20%)\
    tag_score = 100 if old_element["tag"] == candidate["tag"] else 0\
\
    # Compare type (10%)\
    type_score = 100 if old_element["type"] == candidate["type"] else 0\
\
    # Final weighted score\
    final_score = (\
        id_score * 0.4 +\
        text_score * 0.3 +\
        tag_score * 0.2 +\
        type_score * 0.1\
    )\
\
    return final_score\
\
\
print("\\nAI-style self-healing scoring:\\n")\
\
best_match = None\
best_score = 0\
\
for candidate in candidate_elements:\
    score = calculate_confidence(old_element, candidate)\
    print(f"\{candidate['id']\} -> confidence score = \{score:.2f\}")\
\
    if score > best_score:\
        best_score = score\
        best_match = candidate\
\
\
print("\\nBest healed element:")\
print(best_match)\
print("Final confidence score:", round(best_score, 2))\
\
\
# -----------------------------------------\
# Real QA Meaning\
# -----------------------------------------\
# Instead of failing when locator changes:\
# 
\f2 \uc0\u10060 
\f3  Test fails\
\
# System does:\
# 1. Compare old locator with current elements\
# 2. Calculate similarity scores\
# 3. Choose best match\
# 4. Continue execution\
\
# 
\f2 \uc0\u9989 
\f3  Test passes (self-healing)\
\
\
# -----------------------------------------\
# Simple Memory\
# -----------------------------------------\
# Edit Distance \uc0\u8594  count changes\
# Fuzzy Matching \uc0\u8594  similarity score\
# AI Self-Healing \uc0\u8594  smart scoring using multiple attributes\
\
\
# -----------------------------------------\
# 5-second memory\
# -----------------------------------------\
# Compare \uc0\u8594  score \u8594  pick highest \u8594  fix locator automatically\
}