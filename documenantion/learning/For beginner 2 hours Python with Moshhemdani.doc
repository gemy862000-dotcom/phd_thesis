\
Python Full Course \'96 Structured Notes with Examples\
\
# 1. Introduction\
# Python is simple, readable, and powerful\
\
print("Hello World")\
\
\
# 2. Variables & Data Types\
name = "Mohamed"   # string\
age = 25           # int\
height = 1.75      # float\
is_active = True   # bool\
\
print(type(name))\
print(type(age))\
\
\
# 3. Strings\
course = "python course"\
\
# String methods\
print(course.upper())\
print(course.title())\
print(course.find("course"))\
\
# Indexing & slicing\
print(course[0])        # first char\
print(course[0:6])      # slicing\
\
# Membership\
print("py" in course)\
\
\
# 4. Math Operations\
print(10 / 3)   # float division\
print(10 // 3)  # integer division\
print(10 % 3)   # remainder\
print(2 ** 3)   # power\
\
import math\
print(math.ceil(4.2))\
print(math.floor(4.8))\
\
\
# 5. User Input\
# input always returns string\
user_input = input("Enter number: ")\
result = int(user_input) + 5\
print(result)\
\
\
# 6. Conditional Statements\
temperature = 20\
\
if temperature > 20:\
    print("Hot")\
elif temperature < 20:\
    print("Cold")\
else:\
    print("Normal")\
\
# Ternary operator\
age = 18\
status = "Adult" if age >= 18 else "Minor"\
print(status)\
\
# Logical operators\
high_income = True\
good_credit = False\
\
if high_income and good_credit:\
    print("Eligible")\
else:\
    print("Not eligible")\
\
\
# 7. Loops\
\
# For loop\
for i in range(1, 5):\
    print(i)\
\
# While loop\
count = 3\
while count > 0:\
    print(count)\
    count -= 1\
\
# Infinite loop with break\
while True:\
    cmd = input("Enter command: ")\
    if cmd == "quit":\
        break\
\
\
# 8. Nested Loops\
for x in range(2):\
    for y in range(3):\
        print(f"(\{x\}, \{y\})")\
\
\
# 9. Collections\
\
# List\
numbers = [1, 2, 3, 4]\
\
for num in numbers:\
    print(num)\
\
# String iteration\
for char in "python":\
    print(char)\
\
\
# 10. Functions\
\
# Basic function\
def greet():\
    print("Hello!")\
\
greet()\
\
# Function with parameters\
def greet_user(first_name, last_name):\
    print(f"Hi \{first_name\} \{last_name\}")\
\
greet_user("Mohamed", "Gamal")\
\
# Function with return\
def get_message(name):\
    return f"Welcome \{name\}"\
\
msg = get_message("Ali")\
print(msg)\
\
\
# 11. Advanced Function Features\
\
# Named arguments\
def add(a, b):\
    return a + b\
\
print(add(a=2, b=3))\
\
# Variable arguments (*args)\
def multiply(*numbers):\
    result = 1\
    for num in numbers:\
        result *= num\
    return result\
\
print(multiply(2, 3, 4))\
\
\
# 12. File Handling\
file = open("test.txt", "w")\
file.write("Hello File")\
file.close()\
\
# Reading file\
file = open("test.txt", "r")\
print(file.read())\
file.close()\
\
\
# 13. Object-Oriented Programming (OOP)\
\
class Person:\
    def __init__(self, name):\
        self.name = name\
\
    def greet(self):\
        print(f"Hello \{self.name\}")\
\
p1 = Person("Mohamed")\
p1.greet()\
\
\
# 14. Error Handling\
try:\
    x = int("abc")\
except:\
    print("Error occurred")\
\
# Better version\
try:\
    x = int("10")\
    print(x)\
except ValueError:\
    print("Invalid number")\
\
\
# 15. Real-World Example\
\
# Simple automation: count even numbers\
count = 0\
for num in range(1, 21):\
    if num % 2 == 0:\
        count += 1\
\
print(f"Total even numbers: \{count\}")\
\
\
# Final Note:\
# Mastering all these concepts = solid Python foundation}