\
Example\
# 1. Modules / Imports\
# Definition: Load external libraries\
import pandas as pd\
\
# 2. Variables\
# Definition: Store single values\
risk_threshold = 0.8\
dataset_file = "sample_modules.csv"\
\
# 3. Lists\
# Definition: Store multiple values\
selected_tests = []\
\
# 4. Dictionaries\
# Definition: Store structured key-value data\
new_module = \{"module": "payment", "past_failures": 4, "bug_history": 3, "code_changes": 7\}\
\
# 5. Classes\
# Definition: Organize related logic into one structure\
class SimpleDefectModel:\
    def __init__(self, threshold):\
        self.threshold = threshold\
\
    # 6. Functions\
    # Definition: Reusable block of code\
    def predict_risk(self, past_failures, bug_history, code_changes):\
        score = (past_failures * 0.3) + (bug_history * 0.3) + (code_changes * 0.1)\
        return min(score / 3, 1.0)\
\
    def decide_test(self, risk):\
        # 7. Conditions\
        # Definition: Make decisions\
        if risk >= self.threshold:\
            return "run_critical_tests"\
        else:\
            return "run_normal_tests"\
\
# 8. File Handling\
# Definition: Read and write data files\
# Create a small CSV dataset first\
sample_data = pd.DataFrame([\
    \{"module": "payment", "past_failures": 4, "bug_history": 3, "code_changes": 7\},\
    \{"module": "cart", "past_failures": 1, "bug_history": 0, "code_changes": 2\},\
    \{"module": "checkout", "past_failures": 3, "bug_history": 2, "code_changes": 6\}\
])\
sample_data.to_csv(dataset_file, index=False)\
\
# Read dataset\
df = pd.read_csv(dataset_file)\
\
# Create model\
model = SimpleDefectModel(risk_threshold)\
\
# 9. Loops\
# Definition: Repeat actions over many items\
for _, row in df.iterrows():\
    risk = model.predict_risk(row["past_failures"], row["bug_history"], row["code_changes"])\
    action = model.decide_test(risk)\
\
    result = \{\
        "module": row["module"],\
        "risk": round(risk, 2),\
        "action": action\
    \}\
\
    print(result)\
\
    if action == "run_critical_tests":\
        selected_tests.append(f"test_\{row['module']\}")\
\
print("Selected tests:", selected_tests)\
\
# Predict for one new module\
new_risk = model.predict_risk(\
    new_module["past_failures"],\
    new_module["bug_history"],\
    new_module["code_changes"]\
)\
print("New module risk:", round(new_risk, 2))\
print("New module decision:", model.decide_test(new_risk))\
\
# 10. Error Handling\
# Definition: Prevent crash if something goes wrong\
try:\
    broken = 10 / 0\
except Exception as e:\
    print("Handled error:", e)\
\
}